allow { platform_app platform_app_36 } {
    hal_xiaomi_camera_hwservice
}:hwservice_manager find;

allow { platform_app platform_app_36 } {
    DisplayFeatureControl
    miui_multi_display
    perfshielder
    ProcessManager
}:service_manager find;

allow { platform_app platform_app_36 } app_data_file:file execute;

binder_call(platform_app, hal_camera_default)
binder_call(platform_app_36, hal_camera_default)

get_prop(platform_app, vendor_camera_prop)
get_prop(platform_app_36, vendor_camera_prop)